# Server-side application origin used for authentication callback allowlisting.
APP_URL=https://your-app.example

# Server-side deployment safety controls. Production must keep the exception false.
DEPLOYMENT_STAGE=local
ALLOW_UNVERIFIED_EMAIL=false

# Browser-safe Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key