# Server-side application origin used for authentication callback allowlisting.
APP_URL=https://your-app.example

# Browser-safe Supabase project settings. Phase 2 uses these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Optional server-only administrative key for exceptional maintenance tasks.
# Normal application requests must not use this key or bypass Row Level Security.
SUPABASE_SECRET_KEY=your-server-only-secret-key